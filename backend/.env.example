# Annara Backend Environment Configuration
PORT=8080

# MongoDB Connection (use MongoDB Atlas URI or local MongoDB)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/annara?retryWrites=true&w=majority
# For Local MongoDB: mongodb://localhost:27017/annara
MONGODB_URI=mongodb://localhost:27017/annara
MONGODB_DATABASE=annara

# JWT Configuration (Must be at least 32 characters)
JWT_SECRET=replace-with-a-secure-random-32-char-string-in-production
JWT_EXPIRY_HOURS=12

# File Upload Directory
UPLOAD_DIR=uploads

# Allowed CORS Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
